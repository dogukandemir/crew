FROM docker:28-cli AS dockercli
FROM python:3.12-slim
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY src/crew/__init__.py /app/crew/__init__.py
COPY src/crew/execution/process.py src/crew/execution/sandbox_worker.py /app/crew/execution/
CMD ["python", "-m", "crew.execution.sandbox_worker"]
