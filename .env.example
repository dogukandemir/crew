# Crew — environment template.
# Copy to backend/.env (or repo root .env) and fill in. NEVER commit real keys.

# ─── Server ──────────────────────────────────────────────────────────────────
CREW_ENV=dev                       # dev | prod
CREW_HOST=127.0.0.1
CREW_PORT=8787
CREW_LOG_LEVEL=info
CREW_DATA_DIR=../data              # sqlite db, workspaces, artifacts, logs
# Browser origins are explicit in every environment. Change this if Vite uses another port.
CREW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Auth (see docs/08-security-and-governance.md) ───────────────────────────
# Local mode is loopback-only. Token mode always requires a generated signing secret.
CREW_AUTH_MODE=local               # local | token
CREW_JWT_SECRET=                  # token mode: generate with secrets.token_urlsafe(48)
CREW_ACCESS_TOKEN_TTL_MIN=720
# Master key material for the secret vault (agent credentials, provider keys).
CREW_VAULT_KEY=                    # 32-byte urlsafe-base64; generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ─── Model providers (CrewAI native SDKs; only set what you use) ─────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: local models (ollama / vLLM)
OLLAMA_BASE_URL=http://localhost:11434

# Tier routing overrides (docs/04): provider/model per capability tier.
# DeepSeek V4 defaults (legacy deepseek-chat / deepseek-reasoner retired 2026-07-24).
CREW_TIER_REASONING=deepseek/deepseek-v4-pro
CREW_TIER_STANDARD=deepseek/deepseek-flash
CREW_TIER_FAST=deepseek/deepseek-flash
CREW_TIER_EMBED=openai/text-embedding-3-small
# DeepSeek V4 reasoning effort: low | high | max (provider default: high)
CREW_REASONING_EFFORT=low
# Exact model → [input, output] USD per million tokens. Unknown hosted models fail closed.
CREW_MODEL_PRICES={}

# ─── Safety rails (docs/08) ──────────────────────────────────────────────────
CREW_MAX_CONCURRENT_CREWS=2
CREW_MAX_AGENTS_PER_PROJECT=24
CREW_DEFAULT_PROJECT_BUDGET_USD=10.0
CREW_HARD_BUDGET_USD=50.0
CREW_TOOL_SANDBOX=docker           # commands only run in Docker; no host fallback
CREW_EGRESS_ALLOWLIST=             # comma-separated extra domains; empty = default-deny list
CREW_REQUIRE_APPROVAL_ABOVE_USD=2.0

# First boot is Demo. The UI saves an explicit Demo/Live choice in runtime-mode.json.
CREW_OFFLINE_LLM=true
# Optional native workspace root; Docker fixes this to its dedicated volume.
CREW_WORKSPACE_ROOT=
