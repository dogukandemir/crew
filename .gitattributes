# Every text file is LF — in the repository and in checkouts alike — so a Windows
# developer stops seeing "LF will be replaced by CRLF" churn and diffs stay honest.
* text=auto eol=lf

# Binaries: never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
