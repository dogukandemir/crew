FROM docker:29-cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d AS dockercli
# python:3.13-slim
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY src/crew/__init__.py /app/crew/__init__.py
COPY src/crew/execution/process.py src/crew/execution/sandbox_worker.py /app/crew/execution/
# Non-root at runtime. uid/gid 10001 is shared with the API image on purpose:
# the broker creates /sandbox-auth/token with mode 0600 and the API has to read
# it. The Docker socket stays root-owned, so Compose adds the host's socket GID
# to this container's groups (DOCKER_SOCKET_GID in .env, docs/DEPLOYING.md).
RUN groupadd --gid 10001 crew \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin crew \
 && mkdir -p /workspaces /sandbox-auth \
 && chown crew:crew /workspaces /sandbox-auth
ENV HOME=/home/crew \
    PYTHONDONTWRITEBYTECODE=1
EXPOSE 8790
USER crew
CMD ["python", "-m", "crew.execution.sandbox_worker"]
