# Crew: environment template.
# Copy to .env in the repository root (or backend/.env) and fill in.
# NEVER commit real keys. The root .env is read twice: by the app on native runs
# and by Docker Compose for variable interpolation in both compose files.
#
# Every key the application reads is listed here. Keys the code parses into a
# number, boolean or enum keep a valid value on purpose: a blank value for those
# is a hard failure at boot, not a neutral default. For the rest, blank means
# "not set".
#
# Local development: docs/INSTALLATION.md. Host deployment: docs/DEPLOYING.md.

# --- Server -------------------------------------------------------------------
CREW_ENV=dev                       # dev | prod. prod tightens origins and hides error detail
CREW_HOST=127.0.0.1                # listener. Compose images bind 0.0.0.0 inside the container
CREW_PORT=8787
CREW_LOG_LEVEL=info                # debug | info | warning | error
CREW_DATA_DIR=../data              # sqlite db, projects, artifacts, vault.key, backups. Blank resolves to the current directory
# Company workspace root. Blank defaults to ~/crew/workspace; Compose sets /workspaces.
CREW_WORKSPACE_ROOT=
# The browser-origin boundary and the CSRF guard. Exact origins, scheme + host +
# port, comma-separated, no wildcards. Blank denies every browser origin, and a
# request carrying an unlisted Origin is answered 403 "untrusted browser origin".
CREW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Schema check on every event payload before it is written and fanned out
# (docs/11 section 5). Leave it on. Disabling it saves one check per event and
# costs the only guard that catches a malformed or contract-violating payload:
# the event is stored and streamed anyway, with no error at the producer, so the
# drift surfaces later as missing or wrong fields in the board and live feed.
# Off is a debugging switch for a provider emitting bad frames, not a setting
# for production.
CREW_VALIDATE_EVENTS=true
# A request body is refused before it is parsed: over this many bytes the API
# answers 413, and a write with no declared Content-Length is answered 411.
# Keep it at or below the reverse proxy's client_max_body_size so the proxy is
# not the only limit, and raise both together if you upload large files.
CREW_MAX_REQUEST_BYTES=8000000

# --- Authentication (docs/08-security-and-governance.md) ----------------------
# local treats every caller as the administrator and is valid only with a
# loopback listener (or CREW_CONTAINER_LOCAL_AUTH for a container that publishes
# loopback ports). token requires a signing secret of at least 32 characters and
# has no built-in default.
CREW_AUTH_MODE=local               # local | token
CREW_JWT_SECRET=                   # token mode: generate with secrets.token_urlsafe(48)
CREW_ACCESS_TOKEN_TTL_MIN=720      # 1 to 10080 minutes
# Container-only opt-in for local mode. Set it only when the published ports stay
# loopback; it is what lets a container bind 0.0.0.0. The production Compose file
# forces this to false and uses token mode instead.
CREW_CONTAINER_LOCAL_AUTH=false
# The host folder picker (browse the host's folders for a project location) is a
# development affordance. Behind a same-host reverse proxy every peer looks like
# 127.0.0.1, so a deployment opts in explicitly. Leave it false on a host.
CREW_ALLOW_HOST_PICKER=false
# Master key material for the secret vault (provider keys, agent credentials).
# Blank means the app generates data/vault.key on first boot and reuses that file.
# A backup of the encrypted database without this key cannot restore credentials.
CREW_VAULT_KEY=                    # 32-byte urlsafe-base64; generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Model providers (CrewAI native SDKs; set only what you use) ---------------
# Keys can also be stored through the UI, which encrypts them in the vault with
# the master key above. An environment key wins over the stored one.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Compose: name of the workspace volume the sandbox broker mounts.
CREW_WORKSPACE_VOLUME=

# --- Model routing (docs/04) ---------------------------------------------------
# Provider/model per capability tier. An explicit CREW_TIER_* wins over the
# provider chosen in the UI on every boot, so leave these unset unless the
# environment should own the routing. Legacy deepseek-chat / deepseek-reasoner
# were retired by the provider on 2026-07-24; never pin them.
CREW_TIER_REASONING=deepseek/deepseek-v4-pro
CREW_TIER_STANDARD=deepseek/deepseek-flash
CREW_TIER_FAST=deepseek/deepseek-flash
CREW_TIER_EMBED=openai/text-embedding-3-small
# Thinking is a request parameter, not a model. Accepted: none (thinking off) |
# low | high | max; the provider default is HIGH with thinking ON, and thinking
# tokens bill as output. Legacy spellings map: minimal->low, medium/xhigh->high,
# ultra->max.
CREW_REASONING_EFFORT=low
# Exact model -> [cache_miss, output] USD per million tokens, or
# [cache_hit, cache_miss, output] when the provider page names a prefix-cache
# rate. Peak rates; the built-in table carries DeepSeek's off-peak halving.
# Unknown hosted models fail closed. Blank is invalid here; use {}.
CREW_MODEL_PRICES={}

# --- Safety rails (docs/08) -----------------------------------------------------
# Parallel tasks per wave; the provider-call gate shares this number.
CREW_MAX_CONCURRENT_CREWS=4
CREW_MAX_AGENTS_PER_PROJECT=24
CREW_MAX_DEPARTMENTS_PER_PROJECT=6
CREW_DEFAULT_PROJECT_BUDGET_USD=10.0
# Application-side ceiling; no project budget may exceed it.
CREW_HARD_BUDGET_USD=50.0
CREW_REQUIRE_APPROVAL_ABOVE_USD=2.0
CREW_AUTO_HIRE_DEFAULT=true        # new projects start with auto-hire ON; caps still apply
CREW_TOOL_SANDBOX=docker           # commands only run in Docker; no host fallback
CREW_EGRESS_ALLOWLIST=             # comma-separated extra domains; empty = default-deny list
CREW_SANDBOX_URL=                  # Compose: broker URL the API talks to
CREW_SANDBOX_TOKEN_FILE=           # Compose: bearer token file for the sandbox broker

# Run mode. First boot is Demo; a Demo/Live choice saved in the UI
# (runtime-mode.json) wins on every later boot, so an env value decides only the
# first boot. Live also needs a provider key.
CREW_OFFLINE_LLM=true

# --- Database -------------------------------------------------------------------
# CREW_DATABASE_URL=               # overrides the sqlite location when set (sqlite only in this release)

# --- Host deployment: docker-compose.prod.yml (docs/DEPLOYING.md) ----------------
# Read by Compose only, never by the app.
COMPOSE_PROJECT_NAME=crew           # keep it stable: it prefixes the volume names
CREW_IMAGE_TAG=prod                 # image tag to build and to roll back to
CREW_BIND_HOST=127.0.0.1            # host interface the API and UI publish on; loopback keeps them private
CREW_BACKEND_PORT=8787              # host port for the API
CREW_FRONTEND_PORT=5173             # host port for the static UI
# Absolute public origin the UI is compiled against, for example
# https://crew.example.com. It must be one of CREW_CORS_ORIGINS, and the reverse
# proxy must route /api/ and /ws/ of that origin to CREW_BIND_HOST:CREW_BACKEND_PORT.
CREW_PUBLIC_ORIGIN=
# GID of the Docker socket on the host, for the sandbox broker's group_add:
#   stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

# --- Container limits and log rotation (docker-compose.prod.yml) ------------------
CREW_BACKEND_CPUS=2.0
CREW_BACKEND_MEMORY_LIMIT=2g
CREW_BACKEND_PIDS_LIMIT=512
CREW_SANDBOX_CPUS=1.0
CREW_SANDBOX_MEMORY_LIMIT=1g
CREW_SANDBOX_PIDS_LIMIT=256
CREW_FRONTEND_CPUS=0.5
CREW_FRONTEND_MEMORY_LIMIT=256m
CREW_FRONTEND_PIDS_LIMIT=128
CREW_LOG_MAX_SIZE=10m              # json-file rotation per container
CREW_LOG_MAX_FILE=5
